APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# MUST be false on any deployed/production server. When true, Laravel renders
# full stack traces on errors (ZAP "Application Error Disclosure").
APP_DEBUG=true
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailadmin_laravel
DB_USERNAME=root
DB_PASSWORD=
MYSQL_EXTRA_OPTIONS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set both of these to true in any HTTPS (production) deployment.
SESSION_SECURE_COOKIE=false
FORCE_HTTPS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SUPERADMIN_DATA_SYNC_KEY=

# Zonal-OCR sidecar (docker/ocr). The ID scanner posts ID photos here.
# Default host works inside docker-compose; use http://127.0.0.1:5000 when the
# sidecar runs on the host. Scanning degrades gracefully if unreachable.
OCR_SERVICE_URL=http://ocr:5000
OCR_TIMEOUT=60

# Google Gemini API for the in-app assistant. Keep the API key server-side:
# never commit it or expose it through a VITE_* variable. See GEMINI-API-SETUP.md.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30
GEMINI_MODEL=gemini-3.8-flash

# Host-native Ollama vision model for reading handwritten scans of printed
# request forms (Manual Filling). Runs as the `ollama` service in compose.yaml
# (pull qwen2.5vl:3b once — see README). Point this at http://host.docker.internal:11434
# instead if you prefer to run Ollama natively on the host. This is independent
# of Gemini chat and the PaddleOCR ID/waiver scanner. Parsing degrades
# gracefully and drafts stay resumable if the daemon is unreachable.
DOCUMENT_VISION_PROVIDER=ollama
DOCUMENT_VISION_URL=http://ollama:11434
DOCUMENT_VISION_MODEL=qwen2.5vl:3b
DOCUMENT_VISION_TIMEOUT=180
DOCUMENT_VISION_CONTEXT_LENGTH=8192
DOCUMENT_VISION_CONFIDENCE_THRESHOLD=0.55
DOCUMENT_VISION_MAX_IMAGE_EDGE=1600

# LibreOffice conversion sidecar (docker/docxconvert) used for DOCX→PDF. It
# keeps a warm LibreOffice listener, which the app container's own `soffice`
# does not. Leave blank to always use that local binary instead — conversion
# falls back to it automatically whenever the sidecar is unreachable.
DOCX_CONVERT_URL=http://docxconvert:2003
DOCX_CONVERT_TIMEOUT=120

# OnlyOffice Document Server — the in-browser editor for the form builder's
# "Printed template" step. Three URLs, because three different parties talk:
#   PUBLIC   the browser loads the editor script from here (host-visible)
#   INTERNAL Laravel calls the server's command/conversion service
#   APP      the server fetches and saves documents back to Laravel
# Leave ONLYOFFICE_PUBLIC_URL blank to disable the editor entirely.
ONLYOFFICE_PUBLIC_URL=http://localhost:8081
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_APP_URL=http://laravel.test
ONLYOFFICE_PORT=8081
# Must match JWT_SECRET on the onlyoffice service in compose.yaml.
# HS256 needs a 256-bit key, so this must be at least 32 characters or
# signing fails outright. Generate one with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=change-me-to-32-plus-random-characters
ONLYOFFICE_TIMEOUT=60

# Google OAuth (admin/officer "Sign in with Google"). See GOOGLE-AUTH-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/admin/accounts/google/callback"

VITE_APP_NAME="${APP_NAME}"
